PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/genbot_foundation
CLIENT_URL=http://localhost:3000

# Local Ollama LLM API settings
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=You are GenZBot, a helpful, concise, and friendly AI assistant.
LLM_MAX_HISTORY_MESSAGES=20
LLM_TIMEOUT_MS=120000
